<Project>

  <PropertyGroup>
    <!-- Language & Analyzers -->
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Quality gates -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>

    <!-- Common compile -->
    <Deterministic>true</Deterministic>
    <!-- 调试符号嵌入程序集:异常日志带行号,发布目录里也不会多出零散的 .pdb 文件 -->
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Source meta -->
    <Authors>ProductionDashboard</Authors>
    <Company>ProductionDashboard</Company>
    <Product>Production Dashboard</Product>
    <Copyright>© $([System.DateTime]::UtcNow.Year) ProductionDashboard</Copyright>
  </PropertyGroup>

</Project>
