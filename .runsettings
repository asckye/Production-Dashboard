<?xml version="1.0" encoding="utf-8"?>
<!--
  Production Dashboard test run settings.
  Usage: dotnet test (with double-dash)settings .runsettings
-->
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <CollectSourceInformation>true</CollectSourceInformation>
  </RunConfiguration>

  <DataCollectionRunSettings>
    <DataCollectors>
      <!-- coverlet 走 XPlat Code Coverage 适配器,输出 cobertura -->
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Exclude generated code, migrations, UI entrypoints, and third-party packages -->
          <Exclude>[*]*.Migrations.*,[*]*.Generated.*,[ProductionDashboard]ProductionDashboard.App,[ProductionDashboard]ProductionDashboard.Program</Exclude>
          <ExcludeByFile>**/Migrations/**/*.cs,**/obj/**/*.cs,**/*.g.cs,**/*.g.i.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>

          <!-- Include the whole ProductionDashboard assembly -->
          <Include>[ProductionDashboard]*</Include>

          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>true</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
