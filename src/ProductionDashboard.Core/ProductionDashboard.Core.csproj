<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core 层:业务规则、领域模型与接口。
    规则:不引用 WPF、数据库(SQLite/Dapper)、PLC(Sharp7)或 Excel 库 ——
    这些实现放在 Infrastructure 层,界面放在 ProductionDashboard(App 层)。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProductionDashboard.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProductionDashboard.Tests" />
  </ItemGroup>

</Project>
