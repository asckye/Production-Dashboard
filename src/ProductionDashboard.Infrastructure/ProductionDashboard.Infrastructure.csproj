<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure 层:Core 接口的具体实现 —— SQLite 数据访问、Siemens S7 PLC 通信、
    Excel 导出、数据库维护等。只依赖 Core,不引用 WPF。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProductionDashboard.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Sharp7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProductionDashboard.Core\ProductionDashboard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProductionDashboard.Tests" />
  </ItemGroup>

</Project>
