{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "shared": true,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "Plc": {
    "IpAddress": "192.168.0.10",
    "Rack": 0,
    "Slot": 1,
    "SampleMode": "Edge",
    "CompleteSignalAddress": "DB100.DBX0.0",
    "CompleteSeqAddress": "DB100.DBD2",
    "HeartbeatAddress": "DB100.DBW6",
    "PollIntervalMs": 100
  },

  "Display": {
    "FactoryName": "示例车间 | 1 号产线",
    // 安全提示:以下为开发默认弱口令。生产部署务必用环境变量覆盖(不要把强口令写进本文件提交 git):
    //   Windows 服务/系统环境变量:  Display__ExitPassword=强口令   Display__LeaderPassword=强口令
    // 沿用默认值时,AuthService 启动会打印告警;并已启用"连续失败 5 次锁定 3 分钟"防暴力破解。
    "ExitPassword": "1234",
    "LeaderPassword": "leader"
  }
}
