<!--
  win-x64 单文件 + ReadyToRun 发布配置

  使用方式:
      dotnet publish src/ProductionDashboard -c Release -p:PublishProfile=win-x64 -o publish

  产物:
      publish/ProductionDashboard.exe        (约 80 MB,自包含 .NET 10 运行时)
      publish/appsettings.json

  关键开关说明见 README.md。
-->
<Project>
  <PropertyGroup>
    <!-- 输出目录(dotnet publish 用 -o 参数覆盖此值,推荐显式传 -o publish) -->
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish\</PublishDir>

    <!-- 构建模式与目标 -->
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>

    <!-- 自包含:把 .NET 运行时一起塞进 exe,工控机无需预装 .NET 10 -->
    <SelfContained>true</SelfContained>

    <!-- 单文件:几百个 DLL 合并到一个 ProductionDashboard.exe 内 -->
    <PublishSingleFile>true</PublishSingleFile>

    <!-- 单文件中包含原生依赖(SQLite、WPF 等);避免运行时再去 temp 目录解压 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- 单文件压缩,把约 120 MB 压到约 70 MB(首次启动会多几百毫秒解压) -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- ReadyToRun (AOT 预编译):把 IL 提前编成 x64 机器码,冷启动快 30%+ -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>

    <!-- Trimming 默认关:WPF + Sharp7 + Dapper 都靠反射,启用 trimming 会运行时找不到类型 -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- PDB 嵌入到 exe,便于异常日志带行号(单文件 + portable PDB 是正确组合) -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- 用 Velopack/MSIX 时关掉这个,目前直接 robocopy 部署无所谓 -->
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
