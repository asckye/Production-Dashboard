<!--
    浅色主题 — 办公室白板 / 演示场景。
    所有键名跟 Dark.xaml 对齐:Bg0 (主背景) 一路 Bg3 (最浅卡面),
    Text0 / Text1 / Text2 从深到浅,品牌色/状态色用更深一档的饱和值
    保证白底对比度。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 颜色 token ── -->
    <!-- 背景层级 (浅色:Bg0 最深的纸白色 → Bg3 略带浅蓝灰) -->
    <Color x:Key="Color.Bg0">#FFF3F5F8</Color>
    <Color x:Key="Color.Bg1">#FFFFFFFF</Color>
    <Color x:Key="Color.Bg2">#FFFAFBFD</Color>
    <Color x:Key="Color.Bg3">#FFEEF1F6</Color>
    <Color x:Key="Color.BgRadialOuter">#FFEDF1F7</Color>
    <Color x:Key="Color.BgRadialInner">#FFF7F9FC</Color>

    <!-- 描边 (浅色用偏蓝灰,不要纯灰显得脏) -->
    <Color x:Key="Color.Line">#FFE2E8F0</Color>
    <Color x:Key="Color.Line2">#FFCBD5E0</Color>
    <!-- 进度条 / 进度槽轨道色(底色,未填充段)— 浅色下取偏深一档的灰蓝,
         跟白卡背景灰度差约 27%,确保轨道清晰可见(原硬编码 #15FFFFFF 在浅底上会几乎隐形) -->
    <Color x:Key="Color.Track">#FFCBD5E0</Color>

    <!-- 文字 (Text0 主标题/数字 → Text2 弱化描述) -->
    <Color x:Key="Color.Text0">#FF0F172A</Color>
    <Color x:Key="Color.Text1">#FF475569</Color>
    <Color x:Key="Color.Text2">#FF94A3B8</Color>

    <!-- 班次专属色 - 浅底下要深一档才够对比 -->
    <Color x:Key="Color.ShiftA">#FFE67E22</Color>
    <Color x:Key="Color.ShiftA2">#FFB35E0E</Color>
    <Color x:Key="Color.ShiftB">#FF2563EB</Color>
    <Color x:Key="Color.ShiftB2">#FF1D4ED8</Color>

    <!-- 时间维度配色 -->
    <Color x:Key="Color.Hour">#FF0099CC</Color>
    <Color x:Key="Color.Day">#FF00A862</Color>
    <Color x:Key="Color.Week">#FF7C3AED</Color>
    <Color x:Key="Color.Month">#FFDB2777</Color>
    <Color x:Key="Color.Year">#FFD97706</Color>

    <!-- 品牌色 + 状态色 -->
    <Color x:Key="Color.Brand">#FF0099CC</Color>
    <Color x:Key="Color.Success">#FF00A862</Color>
    <Color x:Key="Color.Warning">#FFE67E22</Color>
    <Color x:Key="Color.Danger">#FFDC2626</Color>

    <!-- ── Brush 派生 ── -->
    <SolidColorBrush x:Key="Brush.Bg0" Color="{StaticResource Color.Bg0}" />
    <SolidColorBrush x:Key="Brush.Bg1" Color="{StaticResource Color.Bg1}" />
    <SolidColorBrush x:Key="Brush.Bg2" Color="{StaticResource Color.Bg2}" />
    <SolidColorBrush x:Key="Brush.Bg3" Color="{StaticResource Color.Bg3}" />

    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Line2" Color="{StaticResource Color.Line2}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />

    <SolidColorBrush x:Key="Brush.Text0" Color="{StaticResource Color.Text0}" />
    <SolidColorBrush x:Key="Brush.Text1" Color="{StaticResource Color.Text1}" />
    <SolidColorBrush x:Key="Brush.Text2" Color="{StaticResource Color.Text2}" />

    <SolidColorBrush x:Key="Brush.ShiftA" Color="{StaticResource Color.ShiftA}" />
    <SolidColorBrush x:Key="Brush.ShiftB" Color="{StaticResource Color.ShiftB}" />

    <SolidColorBrush x:Key="Brush.Hour" Color="{StaticResource Color.Hour}" />
    <SolidColorBrush x:Key="Brush.Day" Color="{StaticResource Color.Day}" />
    <SolidColorBrush x:Key="Brush.Week" Color="{StaticResource Color.Week}" />
    <SolidColorBrush x:Key="Brush.Month" Color="{StaticResource Color.Month}" />
    <SolidColorBrush x:Key="Brush.Year" Color="{StaticResource Color.Year}" />

    <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

    <!-- 主屏背景径向渐变 (浅色用极淡蓝白) -->
    <RadialGradientBrush x:Key="Brush.BgRadial" GradientOrigin="0.5,0" Center="0.5,0" RadiusX="1.2" RadiusY="1.0">
        <GradientStop Offset="0" Color="{StaticResource Color.BgRadialInner}" />
        <GradientStop Offset="1" Color="{StaticResource Color.BgRadialOuter}" />
    </RadialGradientBrush>

    <!-- 卡片背景线性渐变 -->
    <LinearGradientBrush x:Key="Brush.CardBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource Color.Bg1}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Bg2}" />
    </LinearGradientBrush>

</ResourceDictionary>
