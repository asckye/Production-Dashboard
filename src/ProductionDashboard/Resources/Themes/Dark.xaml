<!--
    深色主题 (默认) — 工厂大屏首选,长时间观看不刺眼,夜班环境对比度高。
    所有 Color/Brush 键名与 Light.xaml 完全对齐;主题切换 = 替换这份字典,
    XAML 那边的 DynamicResource 引用会自动重解析。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 颜色 token ── -->
    <Color x:Key="Color.Bg0">#FF07090F</Color>
    <Color x:Key="Color.Bg1">#FF0D1220</Color>
    <Color x:Key="Color.Bg2">#FF131A2C</Color>
    <Color x:Key="Color.Bg3">#FF1A2238</Color>
    <Color x:Key="Color.BgRadialOuter">#FF07090F</Color>
    <Color x:Key="Color.BgRadialInner">#FF0D1424</Color>

    <Color x:Key="Color.Line">#FF1F2A44</Color>
    <Color x:Key="Color.Line2">#FF2A3656</Color>
    <!-- 进度条 / 进度槽轨道色(底色,未填充段)— 深色下取跟 Line 同档,
         等效于原硬编码 #15FFFFFF 叠在 Bg0 (#FF07090F) 上的渲染结果 -->
    <Color x:Key="Color.Track">#FF1F2A44</Color>

    <Color x:Key="Color.Text0">#FFFFFFFF</Color>
    <Color x:Key="Color.Text1">#FFA7B0C4</Color>
    <Color x:Key="Color.Text2">#FF6B7388</Color>

    <!-- 班次专属色 - 深色主题下饱和度高,在暗背景上对比强 -->
    <Color x:Key="Color.ShiftA">#FFFF8C42</Color>
    <Color x:Key="Color.ShiftA2">#FFD96A20</Color>
    <Color x:Key="Color.ShiftB">#FF4A9EFF</Color>
    <Color x:Key="Color.ShiftB2">#FF1F5FCC</Color>

    <!-- 时间维度配色 -->
    <Color x:Key="Color.Hour">#FF00D4FF</Color>
    <Color x:Key="Color.Day">#FF00FF88</Color>
    <Color x:Key="Color.Week">#FFAA55FF</Color>
    <Color x:Key="Color.Month">#FFFF6B9D</Color>
    <Color x:Key="Color.Year">#FFFFAA00</Color>

    <!-- 品牌色 + 状态色 -->
    <Color x:Key="Color.Brand">#FF00D4FF</Color>
    <Color x:Key="Color.Success">#FF00FF88</Color>
    <Color x:Key="Color.Warning">#FFFFAA00</Color>
    <Color x:Key="Color.Danger">#FFFF3366</Color>

    <!-- ── Brush 派生 ── -->
    <SolidColorBrush x:Key="Brush.Bg0" Color="{StaticResource Color.Bg0}" />
    <SolidColorBrush x:Key="Brush.Bg1" Color="{StaticResource Color.Bg1}" />
    <SolidColorBrush x:Key="Brush.Bg2" Color="{StaticResource Color.Bg2}" />
    <SolidColorBrush x:Key="Brush.Bg3" Color="{StaticResource Color.Bg3}" />

    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Line2" Color="{StaticResource Color.Line2}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />

    <SolidColorBrush x:Key="Brush.Text0" Color="{StaticResource Color.Text0}" />
    <SolidColorBrush x:Key="Brush.Text1" Color="{StaticResource Color.Text1}" />
    <SolidColorBrush x:Key="Brush.Text2" Color="{StaticResource Color.Text2}" />

    <SolidColorBrush x:Key="Brush.ShiftA" Color="{StaticResource Color.ShiftA}" />
    <SolidColorBrush x:Key="Brush.ShiftB" Color="{StaticResource Color.ShiftB}" />

    <SolidColorBrush x:Key="Brush.Hour" Color="{StaticResource Color.Hour}" />
    <SolidColorBrush x:Key="Brush.Day" Color="{StaticResource Color.Day}" />
    <SolidColorBrush x:Key="Brush.Week" Color="{StaticResource Color.Week}" />
    <SolidColorBrush x:Key="Brush.Month" Color="{StaticResource Color.Month}" />
    <SolidColorBrush x:Key="Brush.Year" Color="{StaticResource Color.Year}" />

    <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

    <!-- 主屏背景径向渐变 -->
    <RadialGradientBrush x:Key="Brush.BgRadial" GradientOrigin="0.5,0" Center="0.5,0" RadiusX="1.2" RadiusY="1.0">
        <GradientStop Offset="0" Color="{StaticResource Color.BgRadialInner}" />
        <GradientStop Offset="1" Color="{StaticResource Color.BgRadialOuter}" />
    </RadialGradientBrush>

    <!-- 卡片背景线性渐变 -->
    <LinearGradientBrush x:Key="Brush.CardBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource Color.Bg1}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Bg2}" />
    </LinearGradientBrush>

</ResourceDictionary>
