<!--
  文本样式 — 卡片标签 / 说明文字 / 正文 / 标题 / 数字专用(等宽避免跳动)。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Text.CardLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.BodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
    </Style>

    <Style
        x:Key="Text.Caption"
        TargetType="TextBlock"
        BasedOn="{StaticResource Text.CardLabel}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text1}" />
    </Style>

    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.H3}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text0}" />
    </Style>

    <!-- 数字专用:启用等宽数字(避免跳动) -->
    <Style x:Key="Text.Number" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text0}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

</ResourceDictionary>
