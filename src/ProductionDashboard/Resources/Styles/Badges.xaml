<!--
  徽章 / 胶囊样式 — 顶栏当前班次徽章 + PLC 状态徽章。

  胶囊徽章 · WPF Border 的 CornerRadius 行为坑:
  如果 CornerRadius 远大于实际 Border 尺寸(比如 999),WPF 会**分别** clamp X 和 Y 半径
  到 width/2 和 height/2 → 当 width ≠ height 时,圆角变成椭圆弧,整个 badge 看上去是椭圆。
  正确的胶囊要求"圆角是真圆":必须 CornerRadius = 固定高度的一半。
  所以这里固定 Height=30,CornerRadius=15,得到清晰的两个半圆端 + 中间直线。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Style.Badge" TargetType="Border">
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 班次徽章 - 默认 ShiftA 色;当 Dashboard.BIsActive=True 时切到 ShiftB -->
    <Style
        x:Key="Style.Badge.Shift"
        TargetType="Border"
        BasedOn="{StaticResource Style.Badge}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Opacity="0.08" Color="{DynamicResource Color.ShiftA}" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ShiftA}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Dashboard.BIsActive}" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.08" Color="{DynamicResource Color.ShiftB}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.ShiftB}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- PLC 在线徽章 -->
    <Style
        x:Key="Style.Badge.Plc"
        TargetType="Border"
        BasedOn="{StaticResource Style.Badge}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Opacity="0.08" Color="{DynamicResource Color.Success}" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
    </Style>

    <Style
        x:Key="Style.Badge.PlcOffline"
        TargetType="Border"
        BasedOn="{StaticResource Style.Badge}">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Opacity="0.08" Color="{DynamicResource Color.Danger}" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
    </Style>

</ResourceDictionary>
