<!--
  Styles 索引字典 — 通过 MergedDictionaries 合并所有 6 个子样式文件。
  App.xaml 引用本文件,运行时所有 x:Key 都暴露在同一个 ResourceDictionary 作用域。

  顺序原则:被引用的样式先合并,引用方后合并。
    1. Cards            (Style.Card, 被 ShiftPanel 等多处 BasedOn 引用)
    2. Typography       (Text.* 基础文本样式)
    3. Badges           (顶栏胶囊徽章)
    4. Buttons          (Primary/Secondary)
    5. DataDisplay      (ProgressBar.* / Metric / ShiftPanel.* — 最大集合)
    6. ScrollBars       (全局滚动条隐式样式)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/Cards.xaml" />
        <ResourceDictionary Source="/Resources/Styles/Typography.xaml" />
        <ResourceDictionary Source="/Resources/Styles/Badges.xaml" />
        <ResourceDictionary Source="/Resources/Styles/Buttons.xaml" />
        <ResourceDictionary Source="/Resources/Styles/DataDisplay.xaml" />
        <ResourceDictionary Source="/Resources/Styles/ScrollBars.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
