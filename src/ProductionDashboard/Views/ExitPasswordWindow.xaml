<Window
    x:Class="ProductionDashboard.Views.ExitPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="退出"
    Width="420"
    MinHeight="300"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource Font.Primary}">
    <Border Padding="32,28" Style="{StaticResource Style.Card}">
        <StackPanel>
            <TextBlock
                Text="退出大屏"
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Heading}" />
            <TextBlock
                Text="请输入退出密码以确认"
                Margin="0,10,0,22"
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Body}" />
            <TextBlock
                Text="密码"
                Margin="0,0,0,6"
                Style="{StaticResource Text.CardLabel}" />
            <PasswordBox x:Name="PwdBox"
                Padding="12,10"
                FontSize="{StaticResource FontSize.BodyLg}"
                Background="{DynamicResource Brush.Bg3}"
                Foreground="{DynamicResource Brush.Text0}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1"
                CaretBrush="{DynamicResource Brush.Brand}"
                KeyDown="OnPasswordKeyDown" />
            <TextBlock x:Name="ErrorText"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Caption}"
                Foreground="{DynamicResource Brush.Danger}"
                Visibility="Collapsed" />
            <StackPanel
                Margin="0,24,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <!--
                    不设 Height,让 Style.Button 的 Padding=20,10,20,10 自适应高度;
                    之前 Height=36 与 Padding 冲突,FontSize 14 的文字被垂直裁切。
                -->
                <Button
                    Content="取消"
                    MinWidth="110"
                    Margin="0,0,12,0"
                    Click="OnCancel"
                    Style="{StaticResource Style.Button.Secondary}" />
                <Button
                    Content="确认退出"
                    MinWidth="140"
                    Click="OnConfirm"
                    IsDefault="True"
                    Style="{StaticResource Style.Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
