<!--
  Dashboard 主视图(大屏看板)。
  3 行布局:
    Row 0  HeroCard + ShiftCompareCard (Hero 大数字 + A/B 班次对比 + 累计对比)
    Row 1  spacer (14px)
    Row 2  FiveDimensionGrid           (5 张大数字卡:本小时 / 今日 / 本周 / 本月 / 本年)
  每一行都是 Views/Dashboard/ 下的独立 UserControl,这里只负责布局骨架。
-->
<UserControl x:Class="ProductionDashboard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dashboard="clr-namespace:ProductionDashboard.Views.Dashboard"
             mc:Ignorable="d"
             d:DesignWidth="1888" d:DesignHeight="920"
             d:Background="#FF0D1424"
             FontFamily="{StaticResource Font.Primary}"
             TextOptions.TextFormattingMode="Ideal">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Hero · 当前班次大数字 + 白班/夜班对比 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <dashboard:HeroCard Grid.Column="0" />
            <dashboard:ShiftCompareCard Grid.Column="2" />
        </Grid>

        <!-- Row 2: 5 维度大数字卡 -->
        <dashboard:FiveDimensionGrid Grid.Row="2" />
    </Grid>
</UserControl>
