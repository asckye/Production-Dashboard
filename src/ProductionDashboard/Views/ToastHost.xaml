<UserControl x:Class="ProductionDashboard.Views.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProductionDashboard.ViewModels"
             IsHitTestVisible="True">
    <UserControl.Resources>
        <!--
            单条 toast 模板。视觉要点(对照参考图):
              · 白色圆角卡 + 柔和投影,看上去"漂"在大屏之上
              · 左侧 32×32 实心圆图标,按严重度上色,中间白符
              · 右侧 ✕ 关闭按钮
              · 底部 3px 倒计时进度条 - ScaleTransform 由 code-behind 启动
            动画要点(让弹出不僵硬):
              · Loaded: TranslateX 80→0 + Opacity 0→1,300ms,Cubic EaseOut
              · IsDismissed=True: 反向滑出 + 淡出,250ms,Cubic EaseIn
              · ToastService 在 IsDismissed 后延迟 280ms 才 Remove,让动画演完
        -->
        <DataTemplate DataType="{x:Type vm:ToastItem}">
            <Border x:Name="ToastCard"
                    Loaded="OnToastLoaded"
                    Margin="0,0,0,10"
                    MinWidth="320" MaxWidth="420"
                    CornerRadius="10"
                    Background="White"
                    BorderBrush="#FFE5E7EB" BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6"
                                      Opacity="0.18" Color="Black" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SlideTransform" X="80" />
                </Border.RenderTransform>

                <!--
                    入场动画 - 400ms QuinticEaseOut:位移 80px → 0,Opacity 0 → 1。
                    Quintic 五次方曲线比 Cubic 减速更慢、尾段更柔,视觉上更"软着陆"。
                -->
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SlideTransform"
                                                 Storyboard.TargetProperty="X"
                                                 From="80" To="0" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <QuinticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <QuinticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <!--
                    关闭(IsDismissed=True)时的退场动画。
                    Style.Setter 里不能用 Storyboard.TargetName,所以用属性路径
                    "(Border.RenderTransform).(TranslateTransform.X)" 直接打到自己的 RenderTransform 上。
                -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDismissed}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.X)"
                                                To="80" Duration="0:0:0.38">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.38">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuinticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                    </Grid.RowDefinitions>

                    <!-- 上方内容区 -->
                    <Grid Grid.Row="0" Margin="16,14,10,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 圆形图标:Ellipse + 内置符号文字 -->
                        <Grid Grid.Column="0" Width="32" Height="32"
                              VerticalAlignment="Top" Margin="0,1,12,0">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF3B82F6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SeverityKey}" Value="Success">
                                                <Setter Property="Fill" Value="#FF10B981" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SeverityKey}" Value="Warning">
                                                <Setter Property="Fill" Value="#FFF59E0B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SeverityKey}" Value="Error">
                                                <Setter Property="Fill" Value="#FFEF4444" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Icon}"
                                       Foreground="White"
                                       FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- 文本 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#FF111827"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Message}"
                                       FontSize="12"
                                       Foreground="#FF6B7280"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       MaxHeight="80"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 关闭按钮(灰色 ✕) -->
                        <Button Grid.Column="2"
                                Command="{Binding DismissCommand}"
                                Content="✕"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FF9CA3AF"
                                FontSize="13" FontWeight="Bold"
                                Width="28" Height="28"
                                Margin="0,-2,0,0"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                ToolTip="关闭" />
                    </Grid>

                    <!--
                        倒计时进度条 - 整条 100% 宽,RenderTransformOrigin 在左侧,
                        code-behind 通过 x:Name="ProgressBar" 找到此元素并启动 ScaleX 从 1→0 动画。
                        Duration = ToastItem.Duration → 进度条走完 = 自动消失瞬间。
                        颜色跟图标圆同色,把"还剩多少时间"和"是什么级别"在视觉上绑在一起。
                    -->
                    <Border x:Name="ProgressBar"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            CornerRadius="0,0,9,9"
                            RenderTransformOrigin="0,0.5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF3B82F6" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SeverityKey}" Value="Success">
                                        <Setter Property="Background" Value="#FF10B981" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SeverityKey}" Value="Warning">
                                        <Setter Property="Background" Value="#FFF59E0B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SeverityKey}" Value="Error">
                                        <Setter Property="Background" Value="#FFEF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        右下角对齐的栈。ItemsControl 纵向 StackPanel,新 toast 追加到底部。
        IsHitTestVisible 默认在 UserControl 上为 True,卡片范围内可点 ✕,
        卡片之间的透明区域 — Background 不设值就是 null,不会拦截鼠标穿透。
    -->
    <ItemsControl ItemsSource="{Binding Items}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,24,24"
                  Focusable="False"
                  Background="Transparent">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
