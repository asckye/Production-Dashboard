<UserControl x:Class="ProductionDashboard.Views.ShiftConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ProductionDashboard.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ShiftConfigViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="1888" d:DesignHeight="920"
             d:Background="#FF0D1424"
             FontFamily="{StaticResource Font.Primary}">

    <UserControl.Resources>
        <!-- 子面板通用样式(灰色边线 + 卡片背景 + 左侧高亮色条) -->
        <Style x:Key="Style.SubPanel" TargetType="Border" BasedOn="{StaticResource Style.Card}">
            <Setter Property="Padding" Value="20,16" />
        </Style>
        <Style x:Key="Style.SubPanelTitle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Style.SubPanelTitleBar" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="16" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
            <Setter Property="Fill" Value="{DynamicResource Brush.Brand}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Style.SubPanelTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text0}" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 标题 + 覆盖提示 ═══ -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="班组配置"
                           FontSize="{StaticResource FontSize.H3}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text0}"
                           VerticalAlignment="Center" />
                <TextBlock Text="班组(名称/班长/成员)+ 班次时段(白班/夜班) · 修改不影响历史数据"
                           Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="14,6,0,0" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding Definitions.CoverageHint}"
                       FontSize="{StaticResource FontSize.Body}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Definitions.IsCoverageValid}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- ═══ 主体:2 列布局 (左主区 + 右 320 sidebar) ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- ── 左主区:时间轴 + 班次列表 ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 24h 时间轴预览面板 -->
                    <Border Style="{StaticResource Style.SubPanel}" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Style="{StaticResource Style.SubPanelTitle}">
                                <Rectangle Style="{StaticResource Style.SubPanelTitleBar}" />
                                <TextBlock Style="{StaticResource Style.SubPanelTitleText}"
                                           Text="24 小时班次预览" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Text="实时预览当前班次配置在 24 小时内的覆盖情况,红线为当前时间"
                                       Margin="0,0,0,10" />

                            <!-- 时间轴 (Canvas + 百分比定位) -->
                            <Grid x:Name="TimelineHost"
                                  Background="#06FFFFFF"
                                  ClipToBounds="True"
                                  Height="56">
                                <ItemsControl ItemsSource="{Binding Definitions.TimelineSegments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource PercentToPixelConverter}">
                                                        <Binding Path="LeftPercent" />
                                                        <Binding Path="ActualWidth" ElementName="TimelineHost" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top" Value="8" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="40" CornerRadius="4"
                                                    Background="{Binding ColorHex}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource PercentToPixelConverter}">
                                                        <Binding Path="WidthPercent" />
                                                        <Binding Path="ActualWidth" ElementName="TimelineHost" />
                                                    </MultiBinding>
                                                </Border.Width>
                                                <TextBlock Text="{Binding Label}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="White"
                                                           FontSize="12" FontWeight="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- NOW 红线 + 标签 -->
                                <Canvas IsHitTestVisible="False">
                                    <!-- 标签 -->
                                    <Border Background="{DynamicResource Brush.Bg0}"
                                            BorderBrush="{DynamicResource Brush.Danger}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4,1"
                                            Canvas.Top="-2">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PercentToPixelConverter}">
                                                <Binding Path="Definitions.NowMarkerLeftPercent" />
                                                <Binding Path="ActualWidth" ElementName="TimelineHost" />
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <TextBlock Text="{Binding Definitions.NowMarkerTimeText}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Danger}" />
                                    </Border>
                                    <!-- 竖红线 -->
                                    <Rectangle Width="2" Height="56"
                                               Fill="{DynamicResource Brush.Danger}">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="{DynamicResource Color.Danger}"
                                                              BlurRadius="8" ShadowDepth="0" />
                                        </Rectangle.Effect>
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PercentToPixelConverter}">
                                                <Binding Path="Definitions.NowMarkerLeftPercent" />
                                                <Binding Path="ActualWidth" ElementName="TimelineHost" />
                                            </MultiBinding>
                                        </Canvas.Left>
                                    </Rectangle>
                                </Canvas>
                            </Grid>

                            <!-- 小时刻度 -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"  Text="00" HorizontalAlignment="Left"   Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="1"  Text="02" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="2"  Text="04" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="3"  Text="06" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="4"  Text="08" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="5"  Text="10" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="6"  Text="12" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="7"  Text="14" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="8"  Text="16" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="9"  Text="18" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="10" Text="20" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                                <TextBlock Grid.Column="11" Text="22" HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                            </Grid>

                            <!-- 覆盖摘要行 -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Definitions.IsCoverageValid}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{DynamicResource Color.Success}"
                                                          BlurRadius="6" ShadowDepth="0" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="{Binding Definitions.CoverageHint}"
                                           FontSize="13" VerticalAlignment="Center"
                                           Margin="0,0,18,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Definitions.IsCoverageValid}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Definitions.CoverageSummary}"
                                           Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 班次列表面板 -->
                    <Border Style="{StaticResource Style.SubPanel}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource Style.SubPanelTitle}">
                                <Rectangle Style="{StaticResource Style.SubPanelTitleBar}" />
                                <TextBlock Style="{StaticResource Style.SubPanelTitleText}"
                                           Text="班次列表" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Definitions.Editables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1"
                                                BorderBrush="{DynamicResource Brush.Line}"
                                                Background="#04FFFFFF"
                                                CornerRadius="{StaticResource Radius.Md}"
                                                Padding="18,14"
                                                Margin="0,0,0,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Opacity" Value="0.45" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>

                                                <Rectangle Grid.Column="0"
                                                           Width="6" Height="56"
                                                           RadiusX="3" RadiusY="3"
                                                           HorizontalAlignment="Left"
                                                           Fill="{Binding ColorHex}" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="22" Height="22" CornerRadius="6"
                                                                Background="{Binding ColorHex}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Code}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="White"
                                                                       FontSize="11" FontWeight="Black" />
                                                        </Border>
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="Transparent"
                                                                 Foreground="{DynamicResource Brush.Text0}"
                                                                 FontSize="{StaticResource FontSize.H4}"
                                                                 FontWeight="Bold"
                                                                 BorderThickness="0,0,0,1"
                                                                 BorderBrush="{DynamicResource Brush.Line}"
                                                                 Margin="10,0,0,0"
                                                                 MinWidth="100" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                                                        <Run Text="代号 " />
                                                        <Run Text="{Binding Code}" Foreground="{DynamicResource Brush.Text1}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="起止时间 (HH:mm)" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="80" Padding="8,6"
                                                                 FontSize="{StaticResource FontSize.BodyLg}"
                                                                 FontWeight="Bold"
                                                                 HorizontalContentAlignment="Center"
                                                                 Background="{DynamicResource Brush.Bg3}"
                                                                 Foreground="{DynamicResource Brush.Text0}"
                                                                 BorderBrush="{DynamicResource Brush.Line}"
                                                                 CaretBrush="{DynamicResource Brush.Brand}" />
                                                        <TextBlock Text="→" Margin="10,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource Brush.Text2}" />
                                                        <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="80" Padding="8,6"
                                                                 FontSize="{StaticResource FontSize.BodyLg}"
                                                                 FontWeight="Bold"
                                                                 HorizontalContentAlignment="Center"
                                                                 Background="{DynamicResource Brush.Bg3}"
                                                                 Foreground="{DynamicResource Brush.Text0}"
                                                                 BorderBrush="{DynamicResource Brush.Line}"
                                                                 CaretBrush="{DynamicResource Brush.Brand}" />
                                                        <Border CornerRadius="{StaticResource Radius.Sm}"
                                                                BorderThickness="1"
                                                                BorderBrush="{DynamicResource Brush.Warning}"
                                                                Padding="6,2"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding CrossesMidnight, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{DynamicResource Color.Warning}" Opacity="0.15" />
                                                            </Border.Background>
                                                            <TextBlock Text="跨日" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{DynamicResource Brush.Warning}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="时长" />
                                                    <TextBlock Text="{Binding DurationLabel}"
                                                               FontSize="{StaticResource FontSize.BodyLg}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Text0}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="目标产量 (件)" />
                                                    <TextBox Text="{Binding TargetCount, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="100" Padding="8,6"
                                                             FontSize="{StaticResource FontSize.BodyLg}"
                                                             FontWeight="Bold"
                                                             HorizontalContentAlignment="Center"
                                                             Background="{DynamicResource Brush.Bg3}"
                                                             Foreground="{DynamicResource Brush.Text0}"
                                                             BorderBrush="{DynamicResource Brush.Line}"
                                                             CaretBrush="{DynamicResource Brush.Brand}"
                                                             Margin="0,4,0,0" />
                                                </StackPanel>

                                                <Button Grid.Column="5"
                                                        Width="36" Height="36"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource Brush.Line}"
                                                        BorderThickness="1"
                                                        Foreground="{DynamicResource Brush.Text2}"
                                                        FontSize="14"
                                                        Content="🗑"
                                                        ToolTip="删除该班次"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.Definitions.DeleteShiftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="+ 添加新班次"
                                    Command="{Binding Definitions.AddShiftCommand}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Brush.Line2}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource Brush.Text1}"
                                    Padding="14"
                                    Margin="0,4,0,0"
                                    FontSize="14" FontWeight="Bold"
                                    Cursor="Hand"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── 右侧 sidebar:班组管理(上下排列两张卡) ── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Style.SubPanel}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource Style.SubPanelTitle}">
                                <Rectangle Style="{StaticResource Style.SubPanelTitleBar}" />
                                <TextBlock Style="{StaticResource Style.SubPanelTitleText}"
                                           Text="班组管理" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Text="生产数据按班组归属,跟人走"
                                       Margin="0,0,0,12" />

                            <ItemsControl ItemsSource="{Binding Teams.EditableTeams}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Padding="14,12"
                                                CornerRadius="{StaticResource Radius.Sm}"
                                                Background="{DynamicResource Brush.Bg2}">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{Binding ColorHex}" />
                                            </Border.BorderBrush>
                                            <Border.BorderThickness>
                                                <Thickness>0,0,0,3</Thickness>
                                            </Border.BorderThickness>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Border Background="{DynamicResource Brush.Bg3}"
                                                            CornerRadius="3"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding Id, StringFormat='班组 #{0}'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Brush.Text2}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="班组名称"
                                                           Style="{StaticResource Text.CardLabel}"
                                                           Margin="0,0,0,4" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="10,8"
                                                         FontSize="14"
                                                         Margin="0,0,0,10"
                                                         Background="{DynamicResource Brush.Bg3}"
                                                         Foreground="{DynamicResource Brush.Text0}"
                                                         BorderBrush="{DynamicResource Brush.Line}"
                                                         BorderThickness="1" />

                                                <TextBlock Text="班长姓名"
                                                           Style="{StaticResource Text.CardLabel}"
                                                           Margin="0,0,0,4" />
                                                <TextBox Text="{Binding LeaderName, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="10,8"
                                                         FontSize="14"
                                                         Background="{DynamicResource Brush.Bg3}"
                                                         Foreground="{DynamicResource Brush.Text0}"
                                                         BorderBrush="{DynamicResource Brush.Line}"
                                                         BorderThickness="1" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══ 底部 footer:只放操作按钮,保存结果通过 toast 提示 ═══ -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消(放弃修改)"
                        Style="{StaticResource Style.Button.Secondary}"
                        Command="{Binding CancelCommand}"
                        Width="180" Height="44" Margin="0,0,12,0" />
                <Button Content="保存并应用"
                        Style="{StaticResource Style.Button.Primary}"
                        Command="{Binding SaveCommand}"
                        Width="180" Height="44" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
