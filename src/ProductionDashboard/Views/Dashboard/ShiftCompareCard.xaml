<!--
  Dashboard 主视图的「白班 vs 夜班 对比卡」UserControl。
  包含三个垂直区域:
    1. 顶部 Header(标题 + 本月领先徽章)
    2. A 班 / B 班 并排卡(各自的字母图标 / 班组名 / 状态徽章 / 大数字 / 目标 / 进度条)
    3. 底部累计对比表(本周 / 本月 / 本年 三行)
  绑定路径:Hero.* 走 HeroAndShiftPresenter, Metrics.* 走 AggregateMetricsPresenter。
-->
<UserControl x:Class="ProductionDashboard.Views.Dashboard.ShiftCompareCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:ProductionDashboard.Controls"
             mc:Ignorable="d"
             FontFamily="{StaticResource Font.Primary}"
             TextOptions.TextFormattingMode="Ideal">
    <Border Style="{StaticResource Style.Card}" Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header (标题 + 领先徽章) -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="3" Height="16" RadiusX="2" RadiusY="2"
                               Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center" />
                    <TextBlock Text="班次实时对比"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text0}"
                               Margin="10,0,12,0" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 领先徽章 · Height=30 + CornerRadius=15。颜色跟本月领先方走:A 班橙色 / B 班蓝色 / 持平中性色 -->
                <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Height="30">
                    <!-- 底色:领先方颜色的 12% 透明度 -->
                    <Border CornerRadius="15" Opacity="0.12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.Text2}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Metrics.MonthLeaderKind}" Value="A">
                                        <Setter Property="Background" Value="{DynamicResource Brush.ShiftA}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Metrics.MonthLeaderKind}" Value="B">
                                        <Setter Property="Background" Value="{DynamicResource Brush.ShiftB}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- 描边 + 文字 -->
                    <Border CornerRadius="15" Padding="14,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text2}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Metrics.MonthLeaderKind}" Value="A">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ShiftA}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Metrics.MonthLeaderKind}" Value="B">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ShiftB}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👑" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Metrics.LeaderText}"
                                       FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Metrics.MonthLeaderKind}" Value="A">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.ShiftA}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Metrics.MonthLeaderKind}" Value="B">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.ShiftB}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Row 2: A 班 | B 班 并排 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- A 班 -->
                <Border Grid.Column="0" Style="{StaticResource Style.ShiftPanel.A}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <!-- 字母图标:Idle 时灰色平面,Active 时 ShiftA 渐变 + 发光 -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Style.ShiftLetter}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hero.AIsActive}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="{DynamicResource Color.ShiftA}" Offset="0" />
                                                                <GradientStop Color="{DynamicResource Color.ShiftA2}" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="{DynamicResource Color.ShiftA}"
                                                                              BlurRadius="12" ShadowDepth="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="白" FontSize="20" FontWeight="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Hero.AIsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Hero.ATeamLabel}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Text0}" />
                                    <TextBlock Text="{Binding Hero.ATeamLeader}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <!-- A班 状态徽章 · 进行中=绿色带发光圆点,其它=灰色仅文字 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Height="22" CornerRadius="11"
                                    Padding="9,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text2}" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource Color.Text2}" Opacity="0.1" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hero.AIsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{DynamicResource Color.Success}" Opacity="0.15" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0"
                                             Visibility="{Binding Hero.AIsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="{DynamicResource Color.Success}"
                                                              BlurRadius="8" ShadowDepth="0" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Hero.AStatus}" VerticalAlignment="Center"
                                               FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Hero.AIsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ctrl:BigNumberDisplay Grid.Row="1" Margin="0,10,0,0"
                                               Value="{Binding Hero.ACount}"
                                               Unit="件"
                                               NumberFontSize="56"
                                               UnitFontSize="16"
                                               AccentColor="{DynamicResource Color.ShiftA}" />

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="目标 " />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           FontWeight="Bold"
                                           Typography.NumeralAlignment="Tabular"
                                           Typography.NumeralStyle="Lining"
                                           Text="{Binding Hero.ATarget}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text=" 件" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.ShiftA}"
                                       Text="{Binding Hero.APercentText}" />
                        </Grid>

                        <ProgressBar Grid.Row="3" Margin="0,4,0,0"
                                     Style="{StaticResource Style.ProgressBar.ShiftA.Slim}"
                                     Value="{Binding Hero.APercent}" />
                    </Grid>
                </Border>

                <!-- B 班 · 外壳自适应:BIsActive=True 时切到蓝色高亮 -->
                <Border Grid.Column="2" Style="{StaticResource Style.ShiftPanel.B}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <!-- 字母图标:Idle 时灰色平面,Active 时 ShiftB 渐变 + 发光 -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Style.ShiftLetter}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hero.BIsActive}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="{DynamicResource Color.ShiftB}" Offset="0" />
                                                                <GradientStop Color="{DynamicResource Color.ShiftB2}" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="{DynamicResource Color.ShiftB}"
                                                                              BlurRadius="12" ShadowDepth="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="夜" FontSize="20" FontWeight="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Hero.BIsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Hero.BTeamLabel}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Text0}" />
                                    <TextBlock Text="{Binding Hero.BTeamLeader}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <!-- B班 状态徽章 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Height="22" CornerRadius="11"
                                    Padding="9,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Text2}" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource Color.Text2}" Opacity="0.1" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hero.BIsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{DynamicResource Color.Success}" Opacity="0.15" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0"
                                             Visibility="{Binding Hero.BIsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="{DynamicResource Color.Success}"
                                                              BlurRadius="8" ShadowDepth="0" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Hero.BStatus}" VerticalAlignment="Center"
                                               FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Hero.BIsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ctrl:BigNumberDisplay Grid.Row="1" Margin="0,10,0,0"
                                               Value="{Binding Hero.BCount}"
                                               Unit="件"
                                               NumberFontSize="56"
                                               UnitFontSize="16"
                                               AccentColor="{DynamicResource Color.ShiftB}" />

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="目标 " />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           FontWeight="Bold"
                                           Typography.NumeralAlignment="Tabular"
                                           Typography.NumeralStyle="Lining"
                                           Text="{Binding Hero.BTarget}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text=" 件" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.ShiftB}"
                                       Text="{Binding Hero.BPercentText}" />
                        </Grid>

                        <ProgressBar Grid.Row="3" Margin="0,4,0,0"
                                     Style="{StaticResource Style.ProgressBar.ShiftB.Slim}"
                                     Value="{Binding Hero.BPercent}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 4: 累计对比 独占整行(7 天图已删) -->
            <Grid Grid.Row="4">
                <Border Background="#06FFFFFF"
                        CornerRadius="{StaticResource Radius.Md}"
                        Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Text.Caption}" Text="累计对比" />
                            <!-- 领先总结·颜色由 CumulativeLeaderKind (A/B/T) 通过 DataTrigger 切换 -->
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="11" FontWeight="Bold"
                                       Text="{Binding Metrics.CumulativeLeaderText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Metrics.CumulativeLeaderKind}" Value="A">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.ShiftA}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Metrics.CumulativeLeaderKind}" Value="B">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.ShiftB}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <!-- IsSharedSizeScope:三行(本周 / 本月 / 本年)的领先标签列共用同一宽度,保持对齐 -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics.CumulativeRows}"
                                      Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <!-- 领先标签按内容自适应宽度(年累计差值可达 5-6 位数),最小 80 保持短标签的原有布局 -->
                                            <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="LeaderLabel" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Text1}"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1">
                                            <Grid Margin="0,1">
                                                <ProgressBar Style="{StaticResource Style.ProgressBar.ShiftA.Slim}"
                                                             Maximum="100" Value="{Binding APct}" />
                                                <TextBlock Text="{Binding ACountText}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Text0}" />
                                            </Grid>
                                            <Grid Margin="0,1">
                                                <ProgressBar Style="{StaticResource Style.ProgressBar.ShiftB.Slim}"
                                                             Maximum="100" Value="{Binding BPct}" />
                                                <TextBlock Text="{Binding BCountText}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Text0}" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right" Margin="6,0,0,0">
                                            <!-- 领先标签颜色跟领先方走:A 班橙色 / B 班蓝色 / 持平中性色 -->
                                            <TextBlock Text="{Binding DiffText}"
                                                       FontSize="13" FontWeight="Bold"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LeaderKind}" Value="A">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.ShiftA}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LeaderKind}" Value="B">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.ShiftB}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DiffPctText}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource Brush.Text2}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
